---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '謝起念 Thomas Sak — 全端工程師',
  description = '專注於複雜業務系統、架構重構與 AI 協作開發。',
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳至主要內容</a>
    <slot />
    <script>
      document.addEventListener('pointermove', (event) => {
        document.documentElement.style.setProperty('--pointer-x', `${event.clientX}px`);
        document.documentElement.style.setProperty('--pointer-y', `${event.clientY}px`);
      }, { passive: true });

      const updateActiveSection = () => {
        const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
        const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
        if (!sections.length || !links.length) return;

        const activate = (id: string) => {
          links.forEach((link) => {
            const active = link.dataset.nav === id;
            link.classList.toggle('is-active', active);
            if (active) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        };

        const syncWithScroll = () => {
          const atPageBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
          if (atPageBottom) {
            activate(sections[sections.length - 1].id);
            return;
          }
          const marker = window.innerHeight * 0.4;
          const current = [...sections].reverse().find((section) => section.getBoundingClientRect().top <= marker);
          activate(current?.id ?? sections[0].id);
        };

        let scheduled = false;
        window.addEventListener('scroll', () => {
          if (scheduled) return;
          scheduled = true;
          requestAnimationFrame(() => {
            syncWithScroll();
            scheduled = false;
          });
        }, { passive: true });
        window.addEventListener('resize', syncWithScroll, { passive: true });
        links.forEach((link) => link.addEventListener('click', () => activate(link.dataset.nav ?? '')));
        syncWithScroll();
      };

      updateActiveSection();
    </script>
  </body>
</html>
